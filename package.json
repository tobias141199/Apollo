{
  "name": "aprendendo-grego",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Webapp de estudo de grego antigo baseado no método JACT (Aprendendo Grego) com complementos do Athenaze — foco em vocabulário.",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:site": "vite",
    "start": "node server/index.ts",
    "build": "tsc -b && vite build",
    "build:public": "tsc -b && vite build --mode public && node scripts/check-public.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "validate": "vitest run src/content",
    "smoke": "node scripts/smoke.mjs http://localhost:5173 smoke"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "dexie": "^4.4.6",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
